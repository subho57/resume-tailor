{
  "name": "resume-tailor",
  "version": "1.4.0",
  "description": "Deterministic, schema-driven resume generator: content JSON + theme preset -> DOCX + PDF, with optional single-page autofit.",
  "bin": {
    "tailor-resume": "dist/cli.js"
  },
  "scripts": {
    "prepare-skill": "bun scripts/generate-skill-bundle.ts",
    "build": "bun run prepare-skill && tsc -p tsconfig.json",
    "compile": "bun run prepare-skill && bun build --compile --outfile=bin/tailor-resume ./src/cli.ts",
    "generate": "bun dist/cli.js --content data/priyanka.resume.json",
    "generate:onepage": "bun dist/cli.js --content data/priyanka.resume.json --one-pager"
  },
  "dependencies": {
    "docx": "9.7.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.1.2",
    "@types/bun": "latest",
    "semantic-release": "^25.0.8",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/github": "^12.0.9"
  },
  "module": "src/cli.ts",
  "type": "module",
  "private": true
}
