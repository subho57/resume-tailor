{
  "name": "resume-superset-builder",
  "version": "1.0.0",
  "description": "Deterministic, schema-driven resume generator: content JSON + theme preset -> DOCX + PDF, with optional single-page autofit.",
  "bin": {
    "build-resume": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "bun build --compile --outfile=bin/build-resume ./src/cli.ts",
    "generate": "bun dist/cli.js --content data/priyanka.resume.json",
    "generate:onepage": "bun dist/cli.js --content data/priyanka.resume.json --auto-fit-to-single-page"
  },
  "dependencies": {
    "docx": "9.7.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/bun": "latest",
    "semantic-release": "^24.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@semantic-release/github": "^11.0.0"
  },
  "module": "src/cli.ts",
  "type": "module",
  "private": true
}
